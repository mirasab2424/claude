{% extends "layout.twig" %}
{% block title %}Тесты{% endblock %}
{% block content %}
<div class="head"><h1>Тесты</h1><a class="btn" href="/admin/tests/new">+ Новый тест</a></div>
{% if tests %}
<div class="tbl box box--flush"><table>
  <thead><tr><th>Тест</th><th>Предмет</th><th>Языки</th><th class="r">Вопр.</th><th class="r">Прошли</th><th class="r">Ср. %</th><th>Статус</th><th></th></tr></thead>
  <tbody>
  {% for t in tests %}
  <tr>
    <td><a class="strong" href="/admin/tests/{{ t.id }}">{{ t.title|l }}</a>{% if t.grades %}<div class="muted small">Классы: {{ t.grades }}</div>{% endif %}{% if me.is_admin and t.teacher_name %}<div class="muted small">{{ t.teacher_name }}</div>{% endif %}</td>
    <td>{{ t.subject_name|l ?: '—' }}</td>
    <td class="nowrap">{% for l in t.langs %}<span class="lang {{ l in t.missing ? 'lang--miss' }}" title="{{ l in t.missing ? 'Перевод неполный' : 'Переведено' }}">{{ l|upper }}</span>{% endfor %}</td>
    <td class="r">{{ t.q_count }}</td>
    <td class="r">{% if t.a_count %}<a href="/admin/stats?test={{ t.id }}">{{ t.a_count }}</a>{% else %}0{% endif %}</td>
    <td class="r">{{ t.a_avg is null ? '—' : t.a_avg|num }}</td>
    <td>
      <form method="post" action="/admin/tests/{{ t.id }}/publish"><input type="hidden" name="_csrf" value="{{ csrf }}">
        <button class="pill {{ t.published ? 'pill--on' : '' }}" title="Нажмите, чтобы {{ t.published ? 'снять с публикации' : 'опубликовать' }}">{{ t.published ? 'Опубликован' : 'Черновик' }}</button></form>
    </td>
    <td class="nowrap actions">
      <a href="/admin/tests/{{ t.id }}">Изменить</a>
      <a href="/t/{{ t.id }}" target="_blank" rel="noopener">Открыть ↗</a>
      <form method="post" action="/admin/tests/{{ t.id }}/copy"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="link">Копия</button></form>
    </td>
  </tr>
  {% endfor %}
  </tbody>
</table></div>
<p class="muted small">Красная метка языка — в тесте есть непереведённые тексты. Ученик на этом языке увидит их на другом языке.</p>
{% else %}
<div class="box"><p>Тестов пока нет.</p><a class="btn" href="/admin/tests/new">Создать первый тест</a></div>
{% endif %}
{% endblock %}
