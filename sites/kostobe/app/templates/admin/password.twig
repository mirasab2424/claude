{% extends "layout.twig" %}
{% block title %}Пароль{% endblock %}
{% block content %}
<h1>Мой пароль</h1>
{% if error %}<p class="alert alert--warn">{{ error }}</p>{% endif %}
<form class="box" method="post" action="/admin/password" style="max-width:420px">
  <input type="hidden" name="_csrf" value="{{ csrf }}">
  <p class="muted small">Логин: <code>{{ me.login }}</code></p>
  <label class="f"><span>Текущий пароль</span><input type="password" name="current" autocomplete="current-password" required></label>
  <label class="f"><span>Новый пароль (от 8 символов)</span><input type="password" name="new" autocomplete="new-password" minlength="8" required></label>
  <label class="f"><span>Повторите новый пароль</span><input type="password" name="repeat" autocomplete="new-password" minlength="8" required></label>
  <button class="btn" type="submit">Сохранить</button>
</form>
{% endblock %}
