{% extends "layout.twig" %}
{% block title %}Пароль{% endblock %}
{% block content %}
<h1>Сменить пароль</h1>
{% if error %}<p class="error">{{ error }}</p>{% endif %}
<form class="box" method="post" action="/admin/password" style="max-width:420px">
  <input type="hidden" name="_csrf" value="{{ csrf }}">
  <label class="f"><span class="f__label">Текущий пароль</span><input type="password" name="current" autocomplete="current-password" required></label>
  <label class="f"><span class="f__label">Новый пароль (от 10 символов)</span><input type="password" name="new" autocomplete="new-password" minlength="10" required></label>
  <label class="f"><span class="f__label">Повторите новый пароль</span><input type="password" name="repeat" autocomplete="new-password" minlength="10" required></label>
  <button class="btn" type="submit">Сохранить</button>
</form>
{% endblock %}
