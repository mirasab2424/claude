<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>{% block title %}Админка{% endblock %} — SMART WAY</title>
  <link rel="icon" href="/img/favicon.png" type="image/png">
  <style>
    :root { --paper:#fffaf3; --tint:#fbefe4; --card:#fff; --ink:#18282d; --muted:#5d6c70; --line:#ecdccb; --pink:#e5427a; --pink-soft:#fde3ec; --teal:#2e8692; --teal-deep:#1e5f6b; --teal-soft:#dff0f1; --sun-soft:#fff1c9; }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--paper); color: var(--ink); font: 400 15px/1.5 "Segoe UI", system-ui, -apple-system, sans-serif; }
    a { color: var(--teal-deep); }
    .top { display: flex; align-items: center; gap: 16px; padding: 10px 20px; background: var(--teal-deep); color: #fff; position: sticky; top: 0; z-index: 10; }
    .top a { color: #fff; text-decoration: none; }
    .top b { font-size: 17px; letter-spacing: .02em; }
    .top .sp { margin-left: auto; display: flex; gap: 14px; align-items: center; }
    .top button { background: none; border: 1px solid rgba(255,255,255,.5); color: #fff; padding: 5px 12px; border-radius: 8px; cursor: pointer; font: inherit; }
    .layout { display: grid; grid-template-columns: 240px 1fr; min-height: calc(100vh - 50px); }
    .side { border-right: 1px solid var(--line); padding: 16px 10px; background: var(--tint); }
    .side h3 { font-size: 12px; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin: 18px 10px 6px; }
    .side a { display: flex; justify-content: space-between; padding: 7px 10px; border-radius: 8px; text-decoration: none; color: var(--ink); }
    .side a:hover, .side a[aria-current] { background: var(--card); }
    .pill { background: var(--pink); color: #fff; border-radius: 999px; padding: 0 8px; font-size: 12px; font-weight: 700; line-height: 20px; }
    main { padding: 24px; min-width: 0; max-width: 1100px; }
    h1 { margin: 0 0 16px; font-size: 26px; }
    .box { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 18px; margin-bottom: 18px; }
    .box h2 { margin: 0 0 12px; font-size: 18px; }
    .flash { background: var(--teal-soft); border-radius: 10px; padding: 10px 14px; margin-bottom: 16px; font-weight: 600; }
    .warn { background: var(--sun-soft); border-radius: 10px; padding: 10px 14px; margin-bottom: 16px; }
    .error { background: var(--pink-soft); border-radius: 10px; padding: 10px 14px; margin-bottom: 16px; color: #8a1240; font-weight: 600; }
    input, textarea, select { font: inherit; width: 100%; padding: 7px 10px; border: 1px solid #d9c7b4; border-radius: 8px; background: #fff; color: var(--ink); }
    textarea { resize: vertical; }
    input:focus, textarea:focus, select:focus { outline: 2px solid var(--teal); border-color: var(--teal); }
    input[type=checkbox] { width: auto; }
    input[type=file] { border: 0; padding: 4px 0; }
    .btn { display: inline-block; border: 0; border-radius: 10px; padding: 9px 18px; font: 700 15px inherit; font-family: inherit; cursor: pointer; background: var(--teal-deep); color: #fff; text-decoration: none; }
    .btn--pink { background: var(--pink); }
    .btn--ghost { background: var(--tint); color: var(--ink); }
    .btn--sm { padding: 5px 12px; font-size: 13px; }
    .f { display: block; margin: 10px 0; }
    .f__label { display: block; font-weight: 700; font-size: 13px; color: var(--muted); margin-bottom: 4px; }
    .l10n { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .l10n label { display: flex; gap: 6px; align-items: flex-start; }
    .l10n i { font-style: normal; font-size: 11px; font-weight: 800; color: var(--teal-deep); background: var(--teal-soft); border-radius: 6px; padding: 2px 5px; margin-top: 8px; }
    .f--img { display: grid; grid-template-columns: 80px 1fr; gap: 6px 12px; align-items: center; }
    .f--img .f__label { grid-column: 1 / -1; margin: 0; }
    .f--img img { width: 80px; height: 80px; object-fit: cover; border-radius: 8px; background: var(--tint); grid-row: span 2; }
    .f--check { display: flex; gap: 8px; align-items: center; font-weight: 600; }
    .checks-row { display: flex; flex-wrap: wrap; gap: 6px 16px; }
    .checks-row label { display: flex; gap: 6px; align-items: center; }
    fieldset.list { border: 1px dashed #d9c7b4; border-radius: 12px; padding: 10px 12px 12px; margin: 12px 0; }
    fieldset.list > legend { font-weight: 800; padding: 0 6px; }
    .item { border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px 4px; margin-bottom: 10px; background: #fffdfa; }
    .list--flat .item { padding: 4px 10px; }
    .list--flat .item .f { margin: 4px 0; }
    .item__bar { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); }
    .item__bar b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .item__bar button { border: 0; background: var(--tint); border-radius: 6px; width: 28px; height: 26px; margin-left: 4px; cursor: pointer; }
    .item__bar button[data-del]:hover { background: var(--pink-soft); }
    .btn-add { border: 1px solid var(--teal); color: var(--teal-deep); background: #fff; border-radius: 8px; padding: 5px 12px; cursor: pointer; font-weight: 700; }
    .savebar { position: sticky; bottom: 0; background: rgba(255,250,243,.95); border-top: 1px solid var(--line); padding: 12px 0; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
    th { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
    .status { display: inline-block; border-radius: 999px; padding: 1px 10px; font-size: 12px; font-weight: 700; background: var(--tint); }
    .status--new { background: var(--pink-soft); color: #8a1240; } .status--work { background: var(--sun-soft); } .status--done { background: var(--teal-soft); color: var(--teal-deep); }
    .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; margin-bottom: 18px; }
    .cards div { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 14px; }
    .cards b { display: block; font-size: 28px; }
    .tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 14px; }
    .tabs a { padding: 6px 12px; border-radius: 999px; background: var(--tint); text-decoration: none; color: var(--ink); font-weight: 600; }
    .tabs a[aria-current] { background: var(--teal-deep); color: #fff; }
    .lead-row form { display: grid; grid-template-columns: 140px 1fr auto auto; gap: 6px; margin-top: 6px; }
    .key { font-family: ui-monospace, monospace; font-size: 12px; color: var(--muted); }
    .changed { box-shadow: inset 3px 0 0 var(--pink); }
    .muted { color: var(--muted); }
    .menu-btn { display: none; }
    @media (max-width: 860px) {
      .layout { grid-template-columns: 1fr; }
      .side { display: none; border-right: 0; border-bottom: 1px solid var(--line); }
      .side.open { display: block; }
      .menu-btn { display: inline-block; }
      .l10n { grid-template-columns: 1fr; }
      main { padding: 16px; }
      .lead-row form { grid-template-columns: 1fr 1fr; }
      .tbl-wrap { overflow-x: auto; }
    }
  </style>
</head>
<body>
{% block body %}
  <header class="top">
    <button class="menu-btn" type="button" onclick="document.querySelector('.side').classList.toggle('open')">☰</button>
    <a href="/admin"><b>SMART WAY</b> · админка</a>
    <span class="sp">
      <a href="/" target="_blank" rel="noopener">Открыть сайт ↗</a>
      <form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="{{ csrf }}"><button>Выйти</button></form>
    </span>
  </header>
  <div class="layout">
    <aside class="side">
      <a href="/admin" {% if uri == '/admin' %}aria-current="page"{% endif %}>Обзор</a>
      <a href="/admin/leads" {% if uri == '/admin/leads' %}aria-current="page"{% endif %}>Заявки {% if new_leads %}<span class="pill">{{ new_leads }}</span>{% endif %}</a>
      <h3>Содержимое сайта</h3>
      {% for key, title in sections %}<a href="/admin/edit/{{ key }}" {% if uri == '/admin/edit/' ~ key %}aria-current="page"{% endif %}>{{ title }}</a>{% endfor %}
      <h3>Тексты интерфейса</h3>
      {% for key, title in text_groups %}<a href="/admin/texts/{{ key }}" {% if uri == '/admin/texts/' ~ key %}aria-current="page"{% endif %}>{{ title }}</a>{% endfor %}
      <h3>Доступ</h3>
      <a href="/admin/password" {% if uri == '/admin/password' %}aria-current="page"{% endif %}>Сменить пароль</a>
    </aside>
    <main>
      {% if initial_password and uri != '/admin/password' %}<p class="warn">Вы входите с начальным паролем. <a href="/admin/password">Смените его</a> — это займёт минуту.</p>{% endif %}
      {% if flash %}<p class="flash">{{ flash }}</p>{% endif %}
      {% block content %}{% endblock %}
    </main>
  </div>
{% endblock %}
<script>
// Списки в редакторе: добавить (из <template>), вверх, вниз, удалить; превью загруженной картинки.
document.addEventListener('click', (e) => {
  const b = e.target.closest('button');
  if (!b) return;
  const item = b.closest('.item');
  if (b.hasAttribute('data-add')) {
    const fs = b.closest('fieldset.list');
    const tpl = fs.querySelector(':scope > template');
    const uid = 'n' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
    const box = document.createElement('div');
    box.innerHTML = tpl.innerHTML.replaceAll(fs.dataset.ph, uid);
    const el = box.firstElementChild;
    fs.querySelector(':scope > .list__items').append(el);
    el.querySelector('input, textarea')?.focus();
  } else if (b.hasAttribute('data-del') && item) {
    if (confirm('Удалить этот пункт?')) item.remove();
  } else if (b.hasAttribute('data-up') && item?.previousElementSibling) {
    item.parentNode.insertBefore(item, item.previousElementSibling);
  } else if (b.hasAttribute('data-down') && item?.nextElementSibling) {
    item.parentNode.insertBefore(item.nextElementSibling, item);
  }
});
document.addEventListener('change', (e) => {
  const inp = e.target;
  if (inp.type === 'file' && inp.files[0]) {
    const img = inp.closest('.f--img')?.querySelector('img');
    if (img) img.src = URL.createObjectURL(inp.files[0]);
  }
});
let dirty = false;
document.addEventListener('input', (e) => { if (e.target.closest('form.editor')) dirty = true; });
document.addEventListener('submit', () => { dirty = false; });
addEventListener('beforeunload', (e) => { if (dirty) { e.preventDefault(); e.returnValue = ''; } });
</script>
</body>
</html>
